              </rowConstraints>
               <children>
                  <Label fx:id="currentExpeditionLabel" text="Current Expedition:" />
                  <Label fx:id="remainingExpeditionsLabel" text="expeditions Remaining:" GridPane.columnIndex="1" />
                  <Label fx:id="goldLabel" text="Gold: " GridPane.columnIndex="2">
                     <GridPane.margin>
                        <Insets right="40.0" />
                     </GridPane.margin>
                  </Label>
               </children>
            </GridPane>
         </children>
      </HBox>
