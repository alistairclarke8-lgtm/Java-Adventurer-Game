<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label text="Select a Guild Name:">
               <padding>
                  <Insets left="20.0" />
               </padding>
            </Label>
            <TextField HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" text="Submit">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <Separator prefWidth="200.0" />
      <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="80.0">
         <children>
            <VBox prefHeight="100.0" prefWidth="180.0">
               <children>
                  <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Label text="How many expeditions:" />
                        <Label fx:id="expeditionCountLabel" text="0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="5.0">
                     <children>
                        <Slider blockIncrement="1.0" max="15.0" showTickLabels="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="180.0">
               <children>
                  <Label text="Choose difficulty:" />
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="144.0" spacing="10.0">
                     <children>
                        <ToggleButton mnemonicParsing="false" text="Easy" />
                        <ToggleButton mnemonicParsing="false" text="Normal" />
                        <ToggleButton mnemonicParsing="false" text="Hard" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <Separator prefWidth="200.0" />
      <VBox alignment="CENTER" prefHeight="144.0" prefWidth="560.0">
         <children>
            <Label prefHeight="17.0" prefWidth="180.0" text="Pick three starting adventurers:" />
            <HBox fx:id="adventurerCardsContainer" prefHeight="80.0" prefWidth="560.0" />
         </children>
      </VBox>
      <Separator prefWidth="200.0" />
      <Button mnemonicParsing="false" text="Start Game" />
   </children>
</VBox>
